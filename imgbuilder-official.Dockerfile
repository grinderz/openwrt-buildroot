# thin asu imagebuilder: the official image plus baked-in third-party
# repositories. asu clients (owut, LuCI) cannot pass repositories in build
# requests and asu leaves the image's repository list alone when the
# request has none — same reasoning as imgbuilder.Dockerfile, but without
# a src build: officially supported devices only need the extra repos.
ARG IB_BASE_IMAGE
FROM $IB_BASE_IMAGE

# generated by Img/ReposExtra/File: repositories-extra.conf lines (empty
# when the config has none) and the collected apk *.pem keys (may be empty)
ARG IB_REPOS_EXTRA_FILE
ARG IB_KEYS_DIR
ARG IB_APK_ALLOW_UNTRUSTED=1

USER buildbot
WORKDIR /builder/

# release images ship the imagebuilder pre-unpacked; snapshot images unpack
# it at runtime via setup.sh, where the appended repos would be lost — the
# script fails on them here, at build time, when there are repos to add
COPY scripts/ib-add-repos.sh /usr/local/bin/ib-add-repos
COPY --chown=buildbot $IB_REPOS_EXTRA_FILE ./repositories-extra.conf
COPY --chown=buildbot $IB_KEYS_DIR ./keys-extra/
RUN ib-add-repos repositories-extra.conf keys-extra && \
    rm -rf repositories-extra.conf keys-extra
