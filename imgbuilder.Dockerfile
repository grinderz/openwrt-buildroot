# local image built by docker-compose.yaml, latest is its only tag
# hadolint ignore=DL3007
FROM varch/openwrt-srcbuilder:latest

ARG SRC_ARTIFACTS_DIR
ARG SRC_IMG_BUILDER_FILE
# generated by Img/ReposExtra/File: repositories-extra.conf lines (empty
# when the config has none) and the collected apk *.pem keys (may be empty)
ARG IB_REPOS_EXTRA_FILE
ARG IB_KEYS_DIR
ARG IB_APK_ALLOW_UNTRUSTED=1

USER buildbot
WORKDIR /builder/

# bind mount, not COPY: a copied archive stays in its own layer even after
# rm in a later RUN, which would carry the whole tarball in every image
# pushed to the asu registry.
# setup.sh no-op: asu runs it for snapshot builds to download the imagebuilder,
# but here it is already unpacked
RUN --mount=type=bind,source=$SRC_ARTIFACTS_DIR/$SRC_IMG_BUILDER_FILE,target=/tmp/imagebuilder.tar.zst \
    tar xf /tmp/imagebuilder.tar.zst --strip=1 --no-same-owner -C . && \
    { [ -f setup.sh ] || printf '#!/bin/sh\nexit 0\n' > setup.sh; }

# bake third-party repositories in: asu clients (owut, LuCI) cannot pass
# repositories in build requests, and asu leaves the image's repository
# list alone when the request has none. opkg and apk handled by the script
COPY scripts/ib-add-repos.sh /usr/local/bin/ib-add-repos
COPY --chown=buildbot $IB_REPOS_EXTRA_FILE ./repositories-extra.conf
COPY --chown=buildbot $IB_KEYS_DIR ./keys-extra/
RUN ib-add-repos repositories-extra.conf keys-extra && \
    rm -rf repositories-extra.conf keys-extra

ENTRYPOINT [ ]
CMD [ "/bin/bash" ]
