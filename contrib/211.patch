From 0c7b600d779269ab6e2b2c810e2dcf136238b6af Mon Sep 17 00:00:00 2001
From: Fil Dunsky <filipp.dunsky@gmail.com>
Date: Sun, 31 Aug 2025 12:17:55 +0300
Subject: [PATCH 1/2] base-files fake update fix

Quick fix so users will not see "fake" update for base-files package and will not update it accidentally which leads to breaking the system making the FS become read-only
---
 package/base-files/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/package/base-files/Makefile b/package/base-files/Makefile
index c78c073699f..7e6db32ddaa 100644
--- a/package/base-files/Makefile
+++ b/package/base-files/Makefile
@@ -13,7 +13,7 @@ include $(INCLUDE_DIR)/feeds.mk
 
 PKG_NAME:=base-files
 PKG_FLAGS:=nonshared
-PKG_RELEASE:=$(COMMITCOUNT)
+PKG_RELEASE:=1860
 
 PKG_FILE_DEPENDS:=$(PLATFORM_DIR)/ $(GENERIC_PLATFORM_DIR)/base-files/
 PKG_BUILD_DEPENDS:=usign/host ucert/host

From 43f8f8bc859cde1e9cd52472c55322dcaca02648 Mon Sep 17 00:00:00 2001
