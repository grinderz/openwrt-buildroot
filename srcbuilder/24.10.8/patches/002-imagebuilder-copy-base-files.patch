From 8f02f3289e17825a643a978c953078ebd7a57d54 Mon Sep 17 00:00:00 2001
From: koshev-msk <konst.shell@gmail.com>
Date: Mon, 23 Dec 2024 17:08:21 +0300
Subject: [PATCH] imagebuilder: dirty: always copy base_files package

---
 target/imagebuilder/Makefile | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/target/imagebuilder/Makefile b/target/imagebuilder/Makefile
index bdbbb45cb1f7e3..99da2f6301d3cc 100644
--- a/target/imagebuilder/Makefile
+++ b/target/imagebuilder/Makefile
@@ -83,6 +83,11 @@ else
 		-exec $(CP) -t $(IB_LDIR)/ {} +
 endif

+	# Always copy base-files package to archive
+	$(FIND) $(wildcard $(PACKAGE_SUBDIRS)) -type f \
+		\( -name 'base-files_*.$(PACKAGE_SUFFIX)' \) \
+		-exec $(CP) -t $(PKG_BUILD_DIR)/packages {} +
+
 ifneq ($(CONFIG_SIGNATURE_CHECK),)
 ifneq ($(CONFIG_USE_APK),y)
 	echo ''                                                        >> $(PKG_BUILD_DIR)/repositories.conf
 