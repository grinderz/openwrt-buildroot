# Pinned image versions, loaded automatically by docker compose
# (project dir = directory of docker-compose.yaml).
# asu publishes no versioned tags, pin :latest by digest.
ASU_IMAGE=docker.io/openwrt/asu:latest@sha256:1bc603faff4e6aa47a3113e61f273daf5c909a1f6203dc997ae449a2edd7ad61
NGINX_IMAGE=docker.io/library/nginx:1.31.2-alpine
PODMAN_IMAGE=quay.io/podman/stable:v5.8.2
REDIS_IMAGE=docker.io/redis/redis-stack-server:7.4.0-v8
REGISTRY_IMAGE=docker.io/library/registry:2.8.3
