uci batch <<__EOI__

# system

## set_system

set system.@system[0].hostname='lec-7233'
set system.@system[0].zonename='Europe/Moscow'
set system.@system[0].timezone='MSK-3'

## set_ntp

del system.ntp.server

add_list system.ntp.server='216.239.35.0'
add_list system.ntp.server='216.239.35.4'
add_list system.ntp.server='216.239.35.8'
add_list system.ntp.server='216.239.35.12'
add_list system.ntp.server='162.159.200.123'
add_list system.ntp.server='162.159.200.1'
add_list system.ntp.server='194.190.168.1'

commit system

# network

## set_packet_steering

set network.globals.packet_steering='2'

commit network

# firewall

## set_hw_offloading

del firewall.@defaults[0].syn_flood
set firewall.@defaults[0].synflood_protect='1'
set firewall.@defaults[0].flow_offloading='1'
set firewall.@defaults[0].flow_offloading_hw='1'

commit firewall

# dhcp

## set_dnsmasq

del dhcp.@dnsmasq[0].filterwin2k
del dhcp.@dnsmasq[0].filter_a
del dhcp.@dnsmasq[0].filter_aaaa
set dhcp.@dnsmasq[0].cachesize='0'
set dhcp.@dnsmasq[0].nonegcache='1'
set dhcp.@dnsmasq[0].confdir='/tmp/dnsmasq.d'

commit dhcp

__EOI__


# set_offload_delay

sed -i 's/meta l4proto { tcp, udp } flow offload @ft;/meta l4proto { tcp, udp } ct original packets ge 30 flow offload @ft;/' /usr/share/firewall4/templates/ruleset.uc

exit 0
